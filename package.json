{
  "name": "layerframe",
  "version": "1.0.0",
  "description": "Browser-only parametric multi-layer colour frame generator (HueForge/LayerStudio style) with an MCP bridge",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "serve": "vite preview",
    "typecheck": "tsc -p .",
    "mcp": "node mcp/server.ts",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clipper-lib": "^6.4.2",
    "jszip": "^3.10.1",
    "three": "^0.169.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
